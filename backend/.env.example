# ── Application ──────────────────────────────────────────────────
APP_NAME=EADIP
APP_VERSION=1.0.0

# ── Authentication / JWT ─────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Security / Encryption ────────────────────────────────────
# Must be a 32 url-safe base64-encoded bytes string.
# You can generate one via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode('utf-8'))"
ENCRYPTION_KEY=your_secure_fernet_key_here

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/eadip

# ── Monitoring Thresholds ────────────────────────────────────────
# Controls behavior of the real-time PostgreSQL Monitoring Agent
MONITORING_LONG_RUNNING_QUERY_SECONDS=5
MONITORING_LONG_RUNNING_TRANSACTION_SECONDS=30
MONITORING_CONNECTION_WARNING_PERCENT=75.0
MONITORING_CONNECTION_CRITICAL_PERCENT=90.0
MONITORING_BLOCKING_QUERY_THRESHOLD=1
MONITORING_IDLE_IN_TRANSACTION_THRESHOLD=1
MONITORING_CACHE_HIT_WARNING_PERCENT=90.0
